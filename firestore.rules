rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      // Each authenticated user owns only their UID namespace.
      return request.auth != null && request.auth.uid == uid;
    }
    function uuid(value) { return value is string && value.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'); }
    function instant(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$'); }
    function text(value, max) { return value is string && value.size() <= max; }
    function validBase(id, d) {
      return d.keys().hasAll(['id', 'createdAt', 'updatedAt', 'deviceId', 'version', 'syncStatus', 'deletedAt'])
        && d.id == id && uuid(d.id) && uuid(d.deviceId)
        && instant(d.createdAt) && instant(d.updatedAt)
        && d.version is int && d.version > 0
        && d.syncStatus in ['pending', 'synced', 'conflict']
        && (d.deletedAt == null || instant(d.deletedAt));
    }
    function keys(d, fields) { return d.keys().hasOnly(['id', 'createdAt', 'updatedAt', 'deviceId', 'version', 'syncStatus', 'deletedAt'].concat(fields)); }
    function valid(category, id, d) {
      return validBase(id, d) && (
        (category == 'tasks' && keys(d, ['title', 'completed', 'projectId', 'parentTaskId', 'notes', 'priority', 'important', 'deadline', 'estimatedMinutes', 'legacyElapsedSeconds', 'legacyId', 'kind', 'sortOrder', 'pinnedToday', 'pinnedTasks', 'widgetEligible'])
          && text(d.title, 1000) && d.completed is bool && text(d.notes, 200000) && d.priority is bool && d.important is bool && d.legacyElapsedSeconds is number && d.legacyElapsedSeconds >= 0)
        || (category == 'projects' && keys(d, ['title', 'description', 'deadline', 'priority', 'status', 'notes', 'estimatedMinutes'])
          && text(d.title, 1000) && text(d.description, 200000) && text(d.notes, 200000) && d.priority in ['low', 'normal', 'high'] && d.status in ['active', 'paused', 'completed', 'archived'])
        || (category == 'activities' && keys(d, ['source', 'taskId', 'projectId', 'title', 'startTime', 'endTime'])
          && text(d.title, 1000) && d.source in ['timer', 'manual', 'journal'] && instant(d.startTime) && (d.endTime == null || instant(d.endTime) && d.endTime >= d.startTime))
        || (category == 'journals' && keys(d, ['kind', 'originalTranscription', 'source', 'date', 'revisionOf'])
          && text(d.originalTranscription, 200000) && d.kind in ['morning', 'evening', 'general'] && d.source in ['manual', 'voice'] && text(d.date, 32))
        || (category == 'cycles' && keys(d, ['periodStart', 'periodEnd', 'notes', 'flow', 'symptoms', 'importedFrom'])
          && text(d.periodStart, 32) && text(d.notes, 200000) && d.flow is list && d.flow.size() <= 400 && d.symptoms is list && d.symptoms.size() <= 200)
        || (category == 'observations' && keys(d, ['date', 'energy', 'mood', 'calm', 'stress', 'bodyState', 'symptoms', 'journalId'])
          && text(d.date, 32) && d.symptoms is list && d.symptoms.size() <= 200)
        || (category == 'memories' && keys(d, ['lifecycle', 'key', 'value', 'confirmedAt', 'expiresAt', 'journalId'])
          && d.lifecycle in ['profile', 'preference', 'routine', 'temporary-context', 'suggestion'] && text(d.key, 1000) && text(d.value, 200000) && (d.confirmedAt == null || instant(d.confirmedAt)))
        || (category == 'reminders' && keys(d, ['title', 'kind', 'intensity', 'scheduledAt', 'enabled'])
          && text(d.title, 1000) && d.kind in ['water', 'meal', 'supplement', 'appointment', 'leave-by', 'custom'] && d.intensity in ['soft', 'important'] && instant(d.scheduledAt) && d.enabled is bool)
        || (category == 'preferences' && keys(d, ['preferredName', 'onboardingComplete', 'modules', 'emphasis', 'routines', 'gentleDate', 'showCompleted'])
          && text(d.preferredName, 100) && d.onboardingComplete is bool && d.modules is map && d.routines is map && d.emphasis is list && d.emphasis.size() <= 30 && d.showCompleted is bool
          && d.modules.keys().hasOnly(['cycle', 'meTime', 'hydration', 'food']) && d.modules.cycle is bool && d.modules.meTime is bool && d.modules.hydration is bool && d.modules.food is bool
          && d.routines.keys().hasOnly(['water', 'meals', 'morning', 'evening']) && d.routines.water is bool && d.routines.meals is bool && d.routines.morning is bool && d.routines.evening is bool)
        || (category == 'meals' && keys(d, ['time', 'kind', 'description', 'photoId', 'protein', 'fibre', 'notes'])
          && instant(d.time) && d.kind in ['breakfast', 'lunch', 'dinner', 'snack'] && text(d.description, 10000) && text(d.notes, 10000) && d.protein in ['yes', 'no', 'unsure'] && d.fibre in ['yes', 'no', 'unsure'])
        || (category == 'hydration' && keys(d, ['time', 'glasses']) && instant(d.time) && d.glasses is int && d.glasses > 0 && d.glasses <= 20)
        || (category == 'careRoutines' && keys(d, ['title', 'timeOfDay', 'enabled']) && text(d.title, 1000) && d.timeOfDay in ['morning', 'evening', 'any'] && d.enabled is bool)
        || (category == 'careLogs' && keys(d, ['routineId', 'date', 'status']) && uuid(d.routineId) && text(d.date, 32) && d.status in ['done', 'taken', 'skipped', 'not-today'])
        || (category == 'suggestions' && keys(d, ['journalId', 'kind', 'value', 'status']) && uuid(d.journalId) && d.kind in ['energy', 'symptom', 'task'] && text(d.value, 10000) && d.status in ['suggested', 'confirmed', 'ignored'])

      );
    }
    function updates(category) {
      return request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.deletedAt == null || request.resource.data.deletedAt != null)
        && (request.resource.data.deletedAt != null || request.resource.data.updatedAt >= resource.data.updatedAt)
        && (category != 'journals' || request.resource.data.originalTranscription == resource.data.originalTranscription);
    }
    match /users/{uid}/{category}/{id} {
      allow read: if owner(uid) && category in ['tasks', 'projects', 'activities', 'journals', 'cycles', 'observations', 'memories', 'reminders', 'preferences', 'meals', 'hydration', 'careRoutines', 'careLogs', 'suggestions'];
      allow create: if owner(uid) && valid(category, id, request.resource.data);
      allow update: if owner(uid) && valid(category, id, request.resource.data) && updates(category);
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
